{{!< default}}

<section class="admin-hero">
    <div class="gh-container admin-hero__inner">
        <h1>Admin</h1>
    </div>
</section>

<section class="mick-pick-generator admin-section">
    <div class="gh-container">
        <h2 class="admin-section__title">Quick Mick Picks</h2>
        <div class="admin-section__inner">
            <div class="mick-pick-edit">
                <form class="mick-pick-form">
                    <label for="load-html">HTML</label>
                    <textarea
                        class="gh-textarea"
                        type="text"
                        name="load-html"
                        id="load-html"
                        required
                        placeholder="Place valid Quick Mick Picks HTML content and fields will auto generate field values"
                    ></textarea>
                    <input
                        class="gh-check"
                        type="checkbox"
                        name="has-video"
                        id="has-video"
                    />
                    <label for="has-video">Has Video</label>
                    <label for="image">Image</label>
                    <input
                        class="gh-input"
                        type="url"
                        name="image"
                        id="image"
                        placeholder="Enter image URL"
                        required
                    />
                    <label for="video">Video</label>
                    <input
                        class="gh-input"
                        type="url"
                        name="video"
                        id="video"
                        placeholder="Enter video URL"
                    />
                    <label for="body">Body</label>
                    <textarea
                        class="gh-textarea"
                        type="text"
                        name="body"
                        id="body"
                        placeholder="Enter body content"
                        required
                    ></textarea>

                </form>

            </div>

            <button type="submit" class="gh-button mick-pick-generate-btn">
                Preview
            </button>

            <div class="mick-pick-preview">
                <div class="mick-pick-preview__inner"></div>
                <button type="button" class="gh-button" id="copy-code" disabled>
                    Copy
                </button>
            </div>

        </div>
    </div>
</section>

<script src="{{asset 'js/generateMickPick.js'}}"></script>