<section class="feature-posts posts {{class}}" data-limit="{{limit}}">
    <div class="feature-posts__inner gh-container">
        {{#if title}}
            <h2 class="feature-posts__title">{{title}}</h2>
        {{/if}}
        <div class="feature-posts-items">
            {{#if featured}}
                {{#get
                    "posts"
                    filter="tag:hash-type-feature+featured:true"
                    limit="{{limit}}"
                    include="tags,authors"
                    order="published_at desc"
                }}
                    {{#foreach posts}}
                        {{> "feature-post"}}
                    {{/foreach}}
                {{/get}}
            {{else}}
                {{#get
                    "posts"
                    filter="tag:hash-type-feature"
                    limit="{{limit}}"
                    include="tags,authors"
                    order="published_at desc"
                }}
                    {{#foreach posts}}
                        {{> "feature-post"}}
                    {{/foreach}}
                {{/get}}
            {{/if}}
        </div>

        {{#match pagination "==" "true"}}
            <nav class="posts-pagination">
                <ul></ul>
            </nav>
        {{/match}}

        {{#if ctaLink}}
            <div class="feature-posts-cta">
                <a class="gh-button" href="{{ctaLink}}">{{ctaLabel}}</a>
            </div>
        {{/if}}
    </div>
</section>

{{#match pagination "==" "true"}}
    <script src="{{asset 'js/postsPagination.js'}}"></script>
{{/match}}