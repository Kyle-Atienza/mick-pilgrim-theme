{{!< default}}

{{#post}}

<section class="custom-post-review-hero">
    <div class="gh-container custom-post-review-hero__inner">
        {{#if feature_image}}
            <img
                class="custom-post-review-hero__image"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            >
            <div class="custom-post-review-hero__image-overlay"></div>
        {{/if}}

        <div class="custom-post-review-hero__content">
            <h1 class="custom-post-review-hero__title">
                {{title}}
                {{!-- <span class="custom-post-review-rating">
                    <span class="custom-post-review-rating__label">MICK PICKS</span>
                    {{> "post-rating"}}
                </span> --}}
            </h1>
            <div class="custom-post-review-rating">
                <span class="custom-post-review-rating__label">MICK PICKS</span>
                    {{> "post-rating"}}
            </div>
        </div>
    </div>
</section>

<section class="custom-post-review-content">
    <div class="gh-container custom-post-review-content__inner">
        <div class="post-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="MMMM D, YYYY"}}
            </time>
        </div>
        <div class="gh-content post-body">
            {{content}}
        </div>
        
        {{!-- <div class="mick-pick">
            <h3 class="mick-pick__title">
