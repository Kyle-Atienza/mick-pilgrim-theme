<section class="post-grid">
    <div class="post-grid__inner gh-container">
        <h3 class="post-grid__title">{{title}}</h3>
        <div class="post-grid-items">
            {{#if excludeId}}
                {{#get
                    "posts"
                    filter="{{filter}}+id:-{{excludeId}}"
                    limit="3"
                    include="tags,authors"
                    order="published_at desc"
                }}
                    {{#foreach posts}}
                        <a href="{{url}}">
                            <article class="post-grid-item">
                                {{#if feature_image}}
                                    <img
                                        class="post-grid-item__image"
                                        src="{{img_url feature_image size="m"}}"
                                        alt="{{title}}"
                                    />
                                    <div
                                        class="post-grid-item__image-overlay"
                                    ></div>
                                {{/if}}
                                <span class="post-grid-item__title">
                                    {{title}}
                                </span>
                            </article>
                        </a>
                    {{/foreach}}
                {{/get}}
            {{else}}
                {{#get
                    "posts"
                    filter="{{filter}}"
                    limit="3"
                    include="tags,authors"
                    order="published_at desc"
                }}
                    {{#foreach posts}}
                        <article class="post-grid-item">
                            <a class="post-grid-item__wrapper" href="{{url}}">
                                {{#if feature_image}}
                                    <img
                                        class="post-grid-item__image"
                                        src="{{img_url feature_image size="m"}}"
                                        alt="{{title}}"
                                    />
                                    <div
                                        class="post-grid-item__image-overlay"
                                    ></div>
                                {{/if}}
                                <span class="post-grid-item__title">
                                    {{title}}
                                </span>
                            </a>
                        </article>
                    {{/foreach}}
                {{/get}}
            {{/if}}
        </div>

        <div class="post-grid-cta">
            <a
                class="gh-button post-grid-cta__link"
                href="{{ctaLink}}"
            >{{ctaLabel}}</a>
        </div>
    </div>
</section>