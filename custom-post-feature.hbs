{{!< default}}

{{#post}}

<main class="post post-feature">

    <section class="post-feature-hero">
        <div class="gh-container post-feature-hero__inner">
            <img
                class="post-feature-hero__image"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            >
            {{#if feature_image}}
            {{/if}}

            <h1 class="post-feature-hero__title">{{title}}</h1>
        </div>

        {{!-- {{#if custom_excerpt}}
            <p class="post-excerpt">{{custom_excerpt}}</p>
