<section class="review-posts posts {{class}}" data-limit="{{limit}}">
    <div class="review-posts__inner gh-container">
        {{#if title}}
            <h3 class="review-posts__title">{{title}}</h3>
        {{/if}}
        <div class="review-posts__header">
            {{#match sort "==" "true"}}
                <div class="review-posts__sort">
                    Sort by 
                    <select>
                        <option value="latest">Latest</option>
                        <option value="oldest">Oldest</option>
                        <option value="rating">Top Rated</option>
                        <option value="title-asc">Films A-Z</option>
                        <option value="title-desc">Films Z-A</option>
                    </select>
                </div>
            {{/match}}
            {{#match pagination "==" "true"}}
                {{> "posts-pagination"}}
            {{/match}}

        </div>
        <div class="review-posts-items">
            {{#if featured}}
                {{#get
                    "posts"
                    filter="{{filter}}+featured:true"
                    limit="{{limit}}"
                    include="tags"
                }}
                    {{#foreach posts}}
                        {{> "review-post"}}
                    {{/foreach}}
                {{/get}}
            {{else if excludeId}}
                {{#get
                    "posts"
                    filter="{{filter}}+id:-{{excludeId}}"
                    limit="{{limit}}"
                    include="tags"
                }}
                    {{#foreach posts}}
                        {{> "review-post"}}
                    {{/foreach}}
                {{/get}}
            {{else}}
                {{#get
                    "posts"
                    filter="{{filter}}"
                    limit="{{limit}}"
                    include="tags"
                }}
                    {{#foreach posts}}
                        {{> "review-post"}}
                    {{/foreach}}
                {{/get}}
            {{/if}}
        </div>

        {{!-- {{#match pagination "==" "true"}}
            <nav class="posts-pagination">
                <ul></ul>
            </nav>
        {{/match}} --}}

        {{#match pagination "==" "true"}}
            {{> "posts-pagination"}}
        {{/match}}

        {{#if ctaLink}}
            <div class="review-posts-cta">
                <a
                    class="gh-button review-posts-cta__link"
                    href="{{ctaLink}}"
                >{{ctaLabel}}</a>
            </div>
        {{/if}}
    </div>
</section>

{{#match pagination "==" "true"}}
    <script src="{{asset 'js/postsPagination.js'}}"></script>
{{/match}} 
<script src="{{asset 'js/postsSort.js'}}"></script>