{{!< default}}

{{#post}}

<main class="post post-review">

    <section class="post-review-hero">
        <div class="gh-container post-review-hero__inner">
            {{#if feature_image}}
                <img
                    class="post-review-hero__image"
                    src="{{img_url feature_image size="xl"}}"
                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                >
            {{/if}}

            <div class="post-review-hero__content">
                <h1 class="post-review-hero__title">
                    {{title}}
                    <span class="post-review-rating">
                        <span class="post-review-rating__label">MICK PICKS</span>
                        {{> "post-rating"}}
                    </span>
                </h1>
            </div>
        </div>
    </section>

    <section class="post-content">
        <div class="gh-container post-content__inner">
            <div class="post-meta">
                <time datetime="{{date format="YYYY-MM-DD"}}">
                    {{date format="MMMM D, YYYY"}}
                </time>
            </div>
            {{content}}
            
