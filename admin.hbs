{{!< default}}
{{!< default}}

<main class="admin">

    <section class="custom-youtube-embed admin-section">
        <div class="gh-container admin-section__inner">
            <div class="admin-section-controls">
                <h2 class="admin-title">Custom YouTube embed</h2>

                <form id="youtube-generator">
                    <label for="link">YouTube video link</label>

                    <input
                        class="gh-input"
                        type="url"
                        name="link"
                        id="link"
                        placeholder="Enter YouTube link"
                        required
                    />

                    <button type="submit" class="gh-button">
                        Generate
                    </button>
                </form>
            </div>

            <div class="admin-section-code-wrapper">
                <button
                    type="button"
                    class="admin-copy-button"
                    id="copy-code"
                    disabled
                >
                    Copy
                </button>

                <pre><code
                        class="admin-section-code"
                        id="generated-code"
                    ></code></pre>
            </div>
        </div>
    </section>

</main>

<script src="{{asset 'js/generateCustomYtEmbed.js'}}"></script>