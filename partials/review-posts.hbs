<section class="review-posts {{class}}">
    <div class="review-posts__inner gh-container">
        {{#if title}}
            <h3 class="review-posts__title">{{title}}</h3>
        {{/if}}
        {{#match sort "==" "true"}}
            <div class="review-posts__sort">
                Sort by 
                <select>
                    <option value="latest">Latest</option>
                    <option value="oldest">Oldest</option>
                    <option value="rating">Top Rated</option>
                    <option value="title-asc">Films A-Z</option>
                    <option value="title-desc">Films Z-A</option>
                </select>
            </div>
        {{/match}}
        <div class="review-posts-items">
            {{#if excludeId}}
                {{#get
                    "posts"
                    filter="{{filter}}+id:-{{excludeId}}"
                    sort="{{sort}}"
                    limit="3"
                    include="tags"
                }}
                    {{#foreach posts}}
                        {{> "review-post"}}
                    {{/foreach}}
                {{/get}}
            {{else}}
                {{#get
                    "posts"
                    filter="{{filter}}"
                    sort="{{sort}}"
                    limit="3"
                    include="tags"
                }}
                    {{#foreach posts}}
                        {{> "review-post"}}
                    {{/foreach}}
                {{/get}}
            {{/if}}
        </div>

        {{!-- TODO pagination --}}
        {{#match pagination "==" "true"}}
            {{> "posts-pagination"}}
        {{/match}}

        {{#if ctaLink}}
            <div class="review-posts-cta">
                <a
                    class="gh-button review-posts-cta__link"
                    href="{{ctaLink}}"
                >{{ctaLabel}}</a>
            </div>
        {{/if}}
    </div>
</section>

<script src="{{asset 'js/reviewPosts.js'}}"></script>