{{!< default}}

{{#post}}

<section class="custom-post-feature-hero">
    <div class="gh-container custom-post-feature-hero__inner">
        {{#if feature_image}}
            <img
                class="custom-post-feature-hero__image"
                src="{{img_url feature_image size="xl"}}"
                alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
            >
            <div class="custom-post-feature-hero__image-overlay"></div>
        {{/if}}

        <h1 class="custom-post-feature-hero__title">{{title}}</h1>
    </div>
</section>

<section class="custom-post-feature-content">
    <div class="gh-container custom-post-feature-content__inner">
        <div class="post-meta">
            <time datetime="{{date format="YYYY-MM-DD"}}">
                {{date format="MMMM D, YYYY"}}
            </time>
        </div>
        <div class="gh-content post-body">
            {{content}}
        </div>
